# Telegram (required)
BOT_TOKEN=
ADMIN_ID=

# Developer info for /aboutme
DEVELOPER_NAME=بابک
DEVELOPER_USERNAME=

# Channel membership gate
# Channel membership gate — bot must be admin for private channels
# Use @username for public channels, or numeric id (e.g. -1001234567890) for private
REQUIRED_CHANNEL=@HiiTRadio

# VIP admin log channel — numeric ID for private channels (e.g. -1001234567890)
# Leave empty to disable VIP logging. Use /channelid (admin) to discover the ID.
VIP_LOG_CHANNEL_ID=

# External support agent (optional). Submitted error reports still DM ADMIN_ID.
# When set, also POST a JSON user_error_report event here (fire-and-forget).
REPORT_WEBHOOK_URL=
# Shared secret for GET /admin/agent/reports and POST /admin/agent/reports/{id}/reply.
# Send it as the X-Agent-Secret header. If empty, those endpoints return 503.
AGENT_REPORT_SECRET=

# SQLite database
DATABASE_PATH=hiit_radio.db

# File cache
CACHE_DIR=cache
CACHE_TTL_HOURS=24
# Concurrent background jobs allowed per user (downloads, playlists, LLM calls)
MAX_ACTIVE_JOBS=3
# Max tracks sent from one playlist/album link
MAX_PLAYLIST_TRACKS=5
# 30s preview voice note while the full track downloads (skip if cache is fast)
PREVIEW_ENABLED=1
PREVIEW_DELAY_SEC=4
# Daily download quotas (calendar day in QUOTA_TZ)
QUOTA_TZ=Asia/Tehran
FREE_DAILY_LIMIT=10
PREMIUM_DAILY_LIMIT=100
TOPUP_AMOUNT=10
REFERRALS_PER_TOPUP=3
# Telegram Stars prices (XTR)
STARS_DAYPASS=15
STARS_WEEKLY=75
STARS_MONTHLY=200
# Bot username without @ (for invite deep-links); falls back to BOT_INLINE
# BOT_USERNAME=HiiTRadioBot
# Telegram API timeouts (raise these if uploads time out on slow VPS links)
# TG_CONNECT_TIMEOUT=30
# TG_READ_TIMEOUT=300
# TG_WRITE_TIMEOUT=300
# TG_MEDIA_WRITE_TIMEOUT=600
# TG_POOL_TIMEOUT=30

# YouTube / yt-dlp
# Downloads run without cookies. Set these only if YouTube starts refusing this IP, and
# only with a throwaway Google account. They are tried after a cookieless attempt fails.
# YTDLP_COOKIES=/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome:Profile-Name
# If YouTube probe fails with "format is not available" under proxychains4:
#   (default) worker clears LD_PRELOAD and uses socks from proxychains.conf via yt-dlp
#   YTDLP_PROXY=socks5h://127.0.0.1:3080   # explicit native proxy
#   YTDLP_INHERIT_PROXYCHAINS=1            # keep LD_PRELOAD (usually breaks formats)

# Spotify metadata API (Developer Dashboard — does not download audio)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# LLM recommendations for /discover (OpenAI-compatible chat completions)
# OpenRouter example:
#   LLM_API_BASE=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-v1-...
#   LLM_MODEL=tencent/hy3:free
#   LLM_REASONING=true
# Or set OPENROUTER_API_KEY instead of LLM_API_KEY.
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=
# OPENROUTER_API_KEY=
LLM_MODEL=tencent/hy3:free
LLM_REASONING=true
# LLM_TIMEOUT=90
# LLM_HTTP_REFERER=https://t.me/your_bot
# LLM_APP_TITLE=HiiT Radio Bot

# Lyrics (optional — LRCLIB works without keys)
GENIUS_API_TOKEN=
MUSIXMATCH_API_KEY=

# Web app + Telegram Mini App API
# Public URL of the Next.js app (Mini App URL). Local dev: http://127.0.0.1:3000
WEBAPP_URL=http://127.0.0.1:3000
# Menu button next to the input: commands (default) or webapp (Mini App; needs HTTPS WEBAPP_URL)
MENU_BUTTON_MODE=commands
# Public URL of the API as the browser sees it. Leave empty to use same-origin
# /backend (Next.js rewrite → FastAPI). Set this if the API has its own hostname.
API_PUBLIC_URL=
# Required: the API refuses to start without a dedicated secret of 32+ characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Serve /docs, /redoc and /openapi.json (off by default)
# API_DOCS=1
JWT_TTL_SEC=604800
# When channel gate is configured: deny access if membership check fails (default: fail open)
# CHANNEL_GATE_FAIL_CLOSED=1
FILE_URL_TTL_SEC=3600
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Optional short name if you register a direct Mini App link
# WEBAPP_SHORT_NAME=app

# Freestyle VMs (https://www.freestyle.sh/docs) — never commit the real key
FREESTYLE_API_KEY=
